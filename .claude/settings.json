{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format --check *)",
      "Bash(sha256sum -c *)",
      "Bash(PYTHONPATH=src python -m onfly_report *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(ruff format *)",
      "Bash(ruff check --fix *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Edit(helpers.py)",
      "Edit(test_currency.py)",
      "Edit(test_nights.py)",
      "Edit(test_regression_report.py)",
      "Edit(test_status_rules.py)",
      "Edit(test_top_hotels.py)",
      "Edit(reservas_hoteis.csv)",
      "Edit(taxas_cambio.csv)",
      "Edit(exemplo-validacao.csv)",
      "Edit(protected-files.sha256)",
      "Edit(.claude/settings.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
